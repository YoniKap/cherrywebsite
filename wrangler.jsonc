{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker/project name in the Cloudflare dashboard.
  "name": "cherrysupreza",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference used by OpenNext's caching; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cherrysupreza",
    },
  ],
  // Later, when real photos land: add an "images": { "binding": "IMAGES" } block
  // for next/image optimization, and an R2 bucket for revalidating caches
  // (see open-next.config.ts).
}
